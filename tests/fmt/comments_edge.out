---- MODULE comments_edge ----
EXTENDS Naturals
VARIABLES x, f

\* PlusCal-style inline block comment on Init ==
Init ==
    (* Global variables *)
    /\ x = 0  \* zero
    (* Process p *)
    /\ f = [i \in {1, 2} |-> 0]

\* Comment between bullet /\ and first item inside LET IN
LetBulletComment ==
    LET a == 1
    IN  /\ (**********************************)
           (* Level correctness.             *)
           (**********************************)
           x = a
        /\ f[1] = 0

\* Trailing line comments right before closing delimiters
TrailingBeforeClose ==
    /\ f' =
           [f EXCEPT
               ![1] = 1,  \* first
               ![2] = 2  \* second
           ]
    /\ [
           a |-> 1,
           b |-> 2  \* last field
       ].a = 1
    /\ <<
           1,
           2  \* last tuple element
       >> = <<1, 2>>
    /\ {
           1,
           2  \* last set element
       } = {1, 2}
====
