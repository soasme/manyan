---- MODULE constructs ----
EXTENDS Naturals, Sequences
CONSTANT C
VARIABLES x, f

RECURSIVE Fact(_)
Fact(n) == IF n = 0 THEN 1 ELSE n * Fact(n - 1)

a ++ b == a + b
-. a == 0 - a
a^+ == a + 1

Rec[n \in 0..5] == IF n = 0 THEN 0 ELSE n + Rec[n - 1]

CaseOp ==
    CASE x = 0 -> 1
      [] x = 1 -> 2
      [] OTHER -> 3

LetOp ==
    LET RECURSIVE G(_)
        G(n) == IF n = 0 THEN 0 ELSE G(n - 1)
        y == G(x)
    IN  /\ y = 0
        /\ f' =
               [f EXCEPT
                   ![1] = @ + 1,  \* increment first
                   ![2] = 0  \* reset second
               ]

QuantOp == \A a \in 1..5 : \E b \in {k \in 1..5 : k > a} : b = a + 1
MapOp == {n * 2 : n \in 1..5}
ChooseOp == CHOOSE <<a, b>> \in (1..3) \X (1..3) : a < b
LabelOp == \A a \in 1..3 : L(a) :: a > 0
SelOp == LabelOp!L(1)
Spec == x = 0 /\ [][x' = x]_x /\ WF_x(x' = x)

-----------------------------------------------------------------------------
ASSUME C \in Nat
THEOREM Spec => [](x = 0)
<1>1. x = 0 => x = 0
  OBVIOUS
<1>2. QED
  BY <1>1
====
